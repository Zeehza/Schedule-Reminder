<header class="topbar">
  <div>
    <div class="topbar-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></div>
    <div class="topbar-sub"><%= typeof pageSub !== 'undefined' ? pageSub : 'Real-time bot statistics & task monitor' %></div>
  </div>
  <div class="topbar-right">
    <% if (typeof showRefresh !== 'undefined' && showRefresh) { %>
    <button id="refresh-btn" class="btn-refresh">
      <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
        <path d="M21 3v5h-5" />
      </svg>
      Refresh
    </button>
    <% } %>
    <div class="user-chip">
      <div class="chip-avatar">SR</div>
      <span class="chip-name">Schedule Reminder</span>
    </div>
  </div>
</header>
